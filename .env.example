# ==============================================================================
# ExcaliSpace - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# Production Tip:
#   Generate a cryptographically secure 32+ character key for NEXTAUTH_SECRET:
#   openssl rand -base64 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & PORT CONFIGURATION
# ------------------------------------------------------------------------------
# The public base URL where your instance is accessible (no trailing slash).
# In production with domain/SSL: https://canvas.yourdomain.com
NEXTAUTH_URL="http://localhost:3001"

# Host port mapped to the web app in docker compose
APP_PORT=3001

# NextAuth secret key used to sign and encrypt JWT session tokens.
# MUST be changed in production!
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-char-string-in-production"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# When running with Docker Compose:
#   Host is "db", port is 5432 (internal container network)
DATABASE_URL="postgresql://postgres:postgres@db:5432/excalispace?schema=public"

# Database credentials for PostgreSQL container initialization
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=excalispace

# Optional: Host port for PostgreSQL (useful for direct local DB inspection)
DB_PORT=5432

# ------------------------------------------------------------------------------
# 3. STORAGE ADAPTER (Local Disk or S3 / MinIO)
# ------------------------------------------------------------------------------
# Storage driver: "local" (default) or "s3"
STORAGE_DRIVER="local"

# Directory path inside container for user uploaded assets
STORAGE_LOCAL_PATH="/app/public/uploads"

# Optional S3 / MinIO Configuration (only if STORAGE_DRIVER="s3"):
# S3_ENDPOINT="http://localhost:9000"
# S3_BUCKET="excalispace-assets"
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="minioadmin"
# S3_REGION="us-east-1"

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL SERVER (SMTP)
# ------------------------------------------------------------------------------
# Leave SMTP_HOST empty ("") to run in simulation/console mode (logs email output).
#
# For Gmail:
#   1. Enable 2-Step Verification in Google Account.
#   2. Generate an App Password (16 characters) under Security -> App Passwords.
#   3. Use port 587 with STARTTLS (SMTP_SECURE=false) or port 465 with SSL (SMTP_SECURE=true).
#
# For Outlook / Office 365:
#   SMTP_HOST="smtp.office365.com", SMTP_PORT=587, SMTP_SECURE=false
#
# For Amazon SES:
#   SMTP_HOST="email-smtp.us-east-1.amazonaws.com", SMTP_PORT=587
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE=false
SMTP_FROM="ExcaliSpace <noreply@excalispace.local>"

# ------------------------------------------------------------------------------
# 5. OAUTH SOCIAL AUTHENTICATION (Optional)
# ------------------------------------------------------------------------------
# GitHub OAuth App: https://github.com/settings/developers
# Callback URL: <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""

# Google OAuth App: https://console.cloud.google.com/apis/credentials
# Callback URL: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
